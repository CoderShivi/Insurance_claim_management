# GET http://localhost:4004/odata/v4/insurance/Policies

### Renew Policy
# POST http://localhost:4004/odata/v4/insurance/renewPolicy
# Content-Type: application/json

# {
#     "policyID": "61111111-1111-1111-1111-111111111111"
# }


### Cancel Policy
# POST http://localhost:4004/odata/v4/insurance/cancelPolicy
# Content-Type: application/json

# {
#     "policyID": "61111111-1111-1111-1111-111111111111"
# }

### Get Policy Status
# GET http://localhost:4004/odata/v4/insurance/getPolicyStatus(policyID=61111111-1111-1111-1111-111111111111)

### Get Policy Claims Count
# GET http://localhost:4004/odata/v4/insurance/getPolicyClaimsCount(policyID=61111111-1111-1111-1111-111111111111)


### Submit Claim
# POST http://localhost:4004/odata/v4/insurance/submitClaim
# Content-Type: application/json

# {
#     "claimID": "71111111-1111-1111-1111-111111111111"
# }

### Approve Claim
# POST http://localhost:4004/odata/v4/insurance/approveClaim
# Content-Type: application/json

# {
#     "claimID": "71111111-1111-1111-1111-111111111111"
# }



### Reject Claim
# POST http://localhost:4004/odata/v4/insurance/rejectClaim
# Content-Type: application/json

# {
#     "claimID": "71111111-1111-1111-1111-111111111111"
# }

### Get Claim Status
GET http://localhost:4004/odata/v4/insurance/getClaimStatus(claimID=71111111-1111-1111-1111-111111111111)

