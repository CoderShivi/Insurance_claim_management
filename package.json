{
  "name": "Insurance_claim_management",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.3",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.3",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite"
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "[production]": {
        "auth": "dummy"
      },
      "destinations": true
    },
    "server": {
      "index": true
    }
  }
}