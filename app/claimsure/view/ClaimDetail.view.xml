<mvc:View controllerName="claimsure.app.controller.ClaimDetail" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
    <Page title="Claim Details" showNavButton="true" navButtonPress="onNavBack" class="csPage">
        <content>
            <VBox class="sapUiMediumMargin" busyIndicatorDelay="0" busy="{claimDetail>/busy}">

                <Panel class="sapUiMediumMarginBottom">
                    <headerToolbar>
                        <OverflowToolbar>
                            <VBox>
                                <Title text="{claimDetail>/claimNumber}" level="H3"/>
                                <Text text="{claimDetail>/description}" class="sapUiTinyMarginTop"/>
                            </VBox>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">

                            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                <ObjectStatus
                                    text="{claimDetail>/status}"
                                    state="{ path: 'claimDetail>/status', formatter: '.formatter.statusState' }"
                                    icon="{ path: 'claimDetail>/status', formatter: '.formatter.statusIcon' }"
                                    class="sapMObjectStatusLarge"/>
                                <ObjectNumber
                                    number="{ path: 'claimDetail>/claimedAmount', formatter: '.formatter.currency' }"
                                    unit="USD"/>
                            </HBox>

                            <form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="0" emptySpanM="0" columnsL="2" columnsM="2">
                                <Label text="Customer"/>
                                <Text text="{
                                    parts: [{path: 'claimDetail>/customer_ID'}, {path: 'lookups>/customers'}],
                                    formatter: '.formatter.idToName'
                                }"/>

                                <Label text="Claim Type"/>
                                <Text text="{
                                    parts: [{path: 'claimDetail>/claimType_ID'}, {path: 'lookups>/claimTypes'}],
                                    formatter: '.formatter.idToName'
                                }"/>

                                <Label text="Policy"/>
                                <Text text="{claimDetail>/policy/policyNumber}"/>

                                <Label text="Incident Date"/>
                                <Text text="{ path: 'claimDetail>/incidentDate', formatter: '.formatter.shortDate' }"/>

                                <Label text="Assigned Agent"/>
                                <Text text="{
                                    parts: [{path: 'claimDetail>/assignedAgent_ID'}, {path: 'lookups>/employees'}],
                                    formatter: '.formatter.idToName'
                                }"/>
                            </form:SimpleForm>

                            <HBox class="sapUiSmallMarginTop">
                                <Button text="{i18n>btnSubmit}" type="Emphasized" press="onSubmitClaim"
                                    visible="{= ${claimDetail>/status} === 'Draft' }" class="sapUiTinyMarginEnd"/>
                                <Button text="{i18n>btnApprove}" type="Accept" press="onApproveClaim"
                                    visible="{= ${claimDetail>/status} === 'PendingApproval' || ${claimDetail>/status} === 'UnderReview' }" class="sapUiTinyMarginEnd"/>
                                <Button text="{i18n>btnReject}" type="Reject" press="onRejectClaim"
                                    visible="{= ${claimDetail>/status} === 'PendingApproval' || ${claimDetail>/status} === 'UnderReview' }"/>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>

                <Panel headerText="Fraud Risk Scores" class="sapUiMediumMarginBottom">
                    <Table items="{claimDetail>/fraudRiskScores}" noDataText="No risk scores recorded">
                        <columns>
                            <Column><Text text="Risk Score"/></Column>
                            <Column><Text text="Risk Level"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{claimDetail>riskScore}"/>
                                    <ObjectStatus text="{claimDetail>riskLevel}" state="{ path: 'claimDetail>riskLevel', formatter: '.formatter.riskState' }"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <Panel headerText="Documents">
                    <Table items="{claimDetail>/documents}" noDataText="No documents uploaded">
                        <columns>
                            <Column><Text text="File Name"/></Column>
                            <Column><Text text="Type"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{claimDetail>fileName}"/>
                                    <Text text="{claimDetail>documentType}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>