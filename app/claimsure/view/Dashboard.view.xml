<mvc:View
    controllerName="claimsure.app.controller.Dashboard"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>navDashboard}" showNavButton="false" class="csPage">
        <content>
            <VBox class="sapUiMediumMargin">

                <Title text="{= 'Welcome back, ' + ${app>/currentUser/name} }" level="H2"/>
                <Text text="{i18n>dashboardSub}" class="sapUiTinyMarginBottom sapUiMediumMarginBottom"/>

                <f:GridContainer id="tileGrid">
                    <f:layout>
                        <f:GridContainerSettings rowSize="6rem" columnSize="14rem" gap="1rem"/>
                    </f:layout>

                    <GenericTile header="{i18n>navClaims}" subheader="View and manage claims" press="onNavClaims" class="sapUiTinyMargin" frameType="OneByOne">
                        <TileContent>
                            <ImageContent src="sap-icon://form"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile header="{i18n>navPolicies}" subheader="View and manage policies" press="onNavPolicies" class="sapUiTinyMargin" frameType="OneByOne">
                        <TileContent>
                            <ImageContent src="sap-icon://shield"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile header="{i18n>navAdmin}" subheader="Employees, customers, claim types" press="onNavAdministration" class="sapUiTinyMargin" frameType="OneByOne">
                        <TileContent>
                            <ImageContent src="sap-icon://official-service"/>
                        </TileContent>
                    </GenericTile>

                </f:GridContainer>

                <Panel headerText="{i18n>recentClaims}" class="sapUiMediumMarginTop">
                    <Table id="recentClaimsTable" items="{recent>/}" noDataText="{i18n>noClaims}">
                        <columns>
                            <Column><Text text="{i18n>colClaimNumber}"/></Column>
                            <Column><Text text="{i18n>colCustomer}"/></Column>
                            <Column><Text text="{i18n>colClaimType}"/></Column>
                            <Column hAlign="End"><Text text="{i18n>colAmount}"/></Column>
                            <Column><Text text="{i18n>colStatus}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press="onClaimPress">
                                <cells>
                                    <ObjectIdentifier title="{recent>claimNumber}"/>
                                    <Text text="{recent>customerName}"/>
                                    <Text text="{recent>claimTypeName}"/>
                                    <ObjectNumber number="{recent>claimedAmount}" unit="USD"/>
                                    <ObjectStatus text="{recent>status}"
                                        state="{= ${recent>status} === 'Rejected' ? 'Error'
                                                 : ${recent>status} === 'Approved' ? 'Success'
                                                 : ${recent>status} === 'PendingApproval' || ${recent>status} === 'UnderReview' ? 'Warning'
                                                 : 'None' }"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>