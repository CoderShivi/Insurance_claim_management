<mvc:View controllerName="claimsure.app.controller.Administration" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core">
    <Page title="{i18n>navAdmin}" showNavButton="false" class="csPage">
        <content>
            <IconTabBar id="adminTabBar" expandable="false" class="sapUiResponsiveMargin">
                <items>

                    <!-- ================= EMPLOYEES ================= -->
                    <IconTabFilter text="{i18n>tabEmployees}" key="employees" icon="sap-icon://employee">
                        <Table id="employeesTable" items="{admin>/Employees}" noDataText="No employees found">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>tabEmployees}" level="H3"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="newEmployeeButton"
                                        icon="sap-icon://add"
                                        text="New Employee"
                                        type="Emphasized"
                                        class="sapUiResponsiveMargin"
                                        press="onCreateEmployee"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="{i18n>colEmployeeNo}"/></Column>
                                <Column><Text text="{i18n>colName}"/></Column>
                                <Column><Text text="{i18n>colEmail}"/></Column>
                                <Column><Text text="{i18n>colDepartment}"/></Column>
                                <Column><Text text="{i18n>colRole}"/></Column>
                                <Column><Text text="{i18n>colActive}"/></Column>
                                <Column><Text text="Actions"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{admin>employeeNumber}"/>
                                        <Text text="{admin>firstName} {admin>lastName}"/>
                                        <Text text="{admin>email}"/>
                                        <Text text="{admin>department}"/>
                                        <Text text="{admin>role}"/>
                                        <Switch state="{admin>active}" change="onEmployeeActiveChange"/>
                                        <HBox justifyContent="Start">
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press="onEditEmployee"/>
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press="onDeleteEmployee"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- ================= CUSTOMERS ================= -->
                    <IconTabFilter text="{i18n>tabCustomers}" key="customers" icon="sap-icon://customer">
                        <Table id="customersTable" items="{admin>/Customers}" noDataText="No customers found">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>tabCustomers}" level="H3"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="newCustomerButton"
                                        icon="sap-icon://add"
                                        text="New Customer"
                                        type="Emphasized"
                                        class="sapUiResponsiveMargin"
                                        press="onCreateCustomer"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="{i18n>colCustomerNo}"/></Column>
                                <Column><Text text="{i18n>colName}"/></Column>
                                <Column><Text text="{i18n>colEmail}"/></Column>
                                <Column><Text text="{i18n>colPhone}"/></Column>
                                <Column><Text text="{i18n>colStatus}"/></Column>
                                <Column><Text text="Actions"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{admin>customerNumber}"/>
                                        <Text text="{admin>firstName} {admin>lastName}"/>
                                        <Text text="{admin>email}"/>
                                        <Text text="{admin>phone}"/>
                                        <ObjectStatus text="{admin>status}" state="{ path: 'admin>status', formatter: '.formatter.statusState' }"/>
                                        <HBox justifyContent="Start">
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press="onEditCustomer"/>
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press="onDeleteCustomer"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- ================= CLAIM TYPES ================= -->
                    <IconTabFilter text="{i18n>tabClaimTypes}" key="claimTypes" icon="sap-icon://form">
                        <Table id="claimTypesTable" items="{admin>/ClaimTypes}" noDataText="No claim types found">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>tabClaimTypes}" level="H3"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="newClaimTypeButton"
                                        icon="sap-icon://add"
                                        text="New Claim Type"
                                        type="Emphasized"
                                        class="sapUiResponsiveMargin"
                                        press="onCreateClaimType"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="{i18n>colCode}"/></Column>
                                <Column><Text text="{i18n>colName}"/></Column>
                                <Column><Text text="{i18n>colCategory}"/></Column>
                                <Column><Text text="{i18n>colActive}"/></Column>
                                <Column><Text text="Actions"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{admin>code}"/>
                                        <Text text="{admin>name}"/>
                                        <Text text="{admin>category}"/>
                                        <Switch state="{admin>active}" change="onClaimTypeActiveChange"/>
                                        <HBox justifyContent="Start">
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press="onEditClaimType"/>
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press="onDeleteClaimType"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>

        <dependents>

            <!-- Create/Edit Employee Dialog (shared) -->
            <Dialog id="employeeDialog" title="New Employee" contentWidth="28rem">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Employee Number" required="true"/>
                        <Input id="empNumberInput" value="{draft>/employeeNumber}"/>

                        <Label text="First Name" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="empFirstNameInput" value="{draft>/firstName}"/>

                        <Label text="Last Name" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="empLastNameInput" value="{draft>/lastName}"/>

                        <Label text="Email" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="empEmailInput" type="Email" value="{draft>/email}"/>

                        <Label text="Department" class="sapUiTinyMarginTop"/>
                        <Input id="empDepartmentInput" value="{draft>/department}"/>

                        <Label text="Role" class="sapUiTinyMarginTop"/>
                        <Input id="empRoleInput" value="{draft>/role}"/>

                        <Label text="Active" class="sapUiTinyMarginTop"/>
                        <Switch id="empActiveSwitch" state="{draft>/active}"/>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Save" type="Emphasized" press="onSaveEmployee"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCancelEmployee"/>
                </endButton>
            </Dialog>

            <!-- Create/Edit Customer Dialog (shared) -->
            <Dialog id="customerDialog" title="New Customer" contentWidth="28rem">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Customer Number" required="true"/>
                        <Input id="custNumberInput" value="{draft>/customerNumber}"/>

                        <Label text="First Name" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="custFirstNameInput" value="{draft>/firstName}"/>

                        <Label text="Last Name" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="custLastNameInput" value="{draft>/lastName}"/>

                        <Label text="Email" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="custEmailInput" type="Email" value="{draft>/email}"/>

                        <Label text="Phone" class="sapUiTinyMarginTop"/>
                        <Input id="custPhoneInput" value="{draft>/phone}"/>

                        <Label text="Status" class="sapUiTinyMarginTop"/>
                        <Select id="custStatusSelect" selectedKey="{draft>/status}">
                            <core:Item key="Active" text="Active"/>
                            <core:Item key="Inactive" text="Inactive"/>
                        </Select>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Save" type="Emphasized" press="onSaveCustomer"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCancelCustomer"/>
                </endButton>
            </Dialog>

            <!-- Create/Edit Claim Type Dialog (shared) -->
            <Dialog id="claimTypeDialog" title="New Claim Type" contentWidth="26rem">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Code" required="true"/>
                        <Input id="ctCodeInput" value="{draft>/code}"/>

                        <Label text="Name" required="true" class="sapUiTinyMarginTop"/>
                        <Input id="ctNameInput" value="{draft>/name}"/>

                        <Label text="Category" class="sapUiTinyMarginTop"/>
                        <Input id="ctCategoryInput" value="{draft>/category}"/>

                        <Label text="Active" class="sapUiTinyMarginTop"/>
                        <Switch id="ctActiveSwitch" state="{draft>/active}"/>
                    </VBox>
                </content>
                <beginButton>
                    <Button text="Save" type="Emphasized" press="onSaveClaimType"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onCancelClaimType"/>
                </endButton>
            </Dialog>

        </dependents>
    </Page>
</mvc:View>