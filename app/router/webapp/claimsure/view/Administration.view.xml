<mvc:View
    controllerName="claimsure.app.controller.Administration"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="administrationPage"
        title="{i18n>navAdmin}"
        showNavButton="false"
        class="csPage"
    >
        <content>
            <IconTabBar
                id="adminTabBar"
                expandable="false"
                class="adminTabBar"
            >
                <items>
                    <!-- ================================================= -->
                    <!-- EMPLOYEES -->
                    <!-- ================================================= -->

                    <IconTabFilter
                        text="{i18n>tabEmployees}"
                        key="employees"
                        icon="sap-icon://employee"
                    >
                        <Table
                            id="employeesTable"
                            items="{admin>/Employees}"
                            noDataText="No employees found"
                            width="100%"
                            fixedLayout="true"
                            growing="true"
                            growingThreshold="20"
                            class="adminTable"
                        >
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title
                                        text="{i18n>tabEmployees}"
                                        level="H3"
                                    />

                                    <ToolbarSpacer />

                                    <Button
                                        id="newEmployeeButton"
                                        icon="sap-icon://add"
                                        text="New Employee"
                                        type="Emphasized"
                                        press="onCreateEmployee"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column width="10rem">
                                    <Text text="{i18n>colEmployeeNo}" />
                                </Column>

                                <Column width="13rem">
                                    <Text text="{i18n>colName}" />
                                </Column>

                                <Column width="17rem">
                                    <Text text="{i18n>colEmail}" />
                                </Column>

                                <Column width="14rem">
                                    <Text text="{i18n>colDepartment}" />
                                </Column>

                                <Column width="11rem">
                                    <Text text="{i18n>colRole}" />
                                </Column>

                                <Column
                                    width="6rem"
                                    hAlign="Center"
                                >
                                    <Text text="{i18n>colActive}" />
                                </Column>

                                <Column
                                    width="7rem"
                                    hAlign="Center"
                                >
                                    <Text text="Actions" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text
                                            text="{admin>employeeNumber}"
                                            wrapping="false"
                                        />

                                        <Text
                                            text="{admin>firstName} {admin>lastName}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>email}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>department}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>role}"
                                            wrapping="true"
                                        />

                                        <Switch
                                            state="{admin>active}"
                                            change="onEmployeeActiveChange"
                                        />

                                        <HBox
                                            width="100%"
                                            justifyContent="Center"
                                            alignItems="Center"
                                        >
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press="onEditEmployee"
                                            />

                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press="onDeleteEmployee"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- ================================================= -->
                    <!-- CUSTOMERS -->
                    <!-- ================================================= -->

                    <IconTabFilter
                        text="{i18n>tabCustomers}"
                        key="customers"
                        icon="sap-icon://customer"
                    >
                        <Table
                            id="customersTable"
                            items="{admin>/Customers}"
                            noDataText="No customers found"
                            width="100%"
                            fixedLayout="true"
                            growing="true"
                            growingThreshold="20"
                            class="adminTable"
                        >
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title
                                        text="{i18n>tabCustomers}"
                                        level="H3"
                                    />

                                    <ToolbarSpacer />

                                    <Button
                                        id="newCustomerButton"
                                        icon="sap-icon://add"
                                        text="New Customer"
                                        type="Emphasized"
                                        press="onCreateCustomer"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column width="11rem">
                                    <Text text="{i18n>colCustomerNo}" />
                                </Column>

                                <Column width="14rem">
                                    <Text text="{i18n>colName}" />
                                </Column>

                                <Column width="18rem">
                                    <Text text="{i18n>colEmail}" />
                                </Column>

                                <Column width="12rem">
                                    <Text text="{i18n>colPhone}" />
                                </Column>

                                <Column width="9rem">
                                    <Text text="{i18n>colStatus}" />
                                </Column>

                                <Column
                                    width="7rem"
                                    hAlign="Center"
                                >
                                    <Text text="Actions" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text
                                            text="{admin>customerNumber}"
                                            wrapping="false"
                                        />

                                        <Text
                                            text="{admin>firstName} {admin>lastName}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>email}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>phone}"
                                            wrapping="false"
                                        />

                                        <ObjectStatus
                                            text="{admin>status}"
                                            state="{
                                                path: 'admin>status',
                                                formatter: '.formatter.statusState'
                                            }"
                                        />

                                        <HBox
                                            width="100%"
                                            justifyContent="Center"
                                            alignItems="Center"
                                        >
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press="onEditCustomer"
                                            />

                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press="onDeleteCustomer"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- ================================================= -->
                    <!-- CLAIM TYPES -->
                    <!-- ================================================= -->

                    <IconTabFilter
                        text="{i18n>tabClaimTypes}"
                        key="claimTypes"
                        icon="sap-icon://form"
                    >
                        <Table
                            id="claimTypesTable"
                            items="{admin>/ClaimTypes}"
                            noDataText="No claim types found"
                            width="100%"
                            fixedLayout="true"
                            growing="true"
                            growingThreshold="20"
                            class="adminTable"
                        >
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title
                                        text="{i18n>tabClaimTypes}"
                                        level="H3"
                                    />

                                    <ToolbarSpacer />

                                    <Button
                                        id="newClaimTypeButton"
                                        icon="sap-icon://add"
                                        text="New Claim Type"
                                        type="Emphasized"
                                        press="onCreateClaimType"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column width="11rem">
                                    <Text text="{i18n>colCode}" />
                                </Column>

                                <Column width="18rem">
                                    <Text text="{i18n>colName}" />
                                </Column>

                                <Column width="11rem">
                                    <Text text="{i18n>colCategory}" />
                                </Column>

                                <Column
                                    width="6rem"
                                    hAlign="Center"
                                >
                                    <Text text="{i18n>colActive}" />
                                </Column>

                                <Column
                                    width="7rem"
                                    hAlign="Center"
                                >
                                    <Text text="Actions" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text
                                            text="{admin>code}"
                                            wrapping="false"
                                        />

                                        <Text
                                            text="{admin>name}"
                                            wrapping="true"
                                        />

                                        <Text
                                            text="{admin>category}"
                                            wrapping="false"
                                        />

                                        <Switch
                                            state="{admin>active}"
                                            change="onClaimTypeActiveChange"
                                        />

                                        <HBox
                                            width="100%"
                                            justifyContent="Center"
                                            alignItems="Center"
                                        >
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press="onEditClaimType"
                                            />

                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press="onDeleteClaimType"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>

        <!-- ============================================================= -->
        <!-- DIALOGS -->
        <!-- ============================================================= -->

        <dependents>
            <!-- ========================================================= -->
            <!-- EMPLOYEE DIALOG -->
            <!-- ========================================================= -->

            <Dialog
                id="employeeDialog"
                title="New Employee"
                contentWidth="30rem"
            >
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label
                            text="Employee Number"
                            required="true"
                        />

                        <Input
                            id="empNumberInput"
                            value="{draft>/employeeNumber}"
                        />

                        <Label
                            text="First Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="empFirstNameInput"
                            value="{draft>/firstName}"
                        />

                        <Label
                            text="Last Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="empLastNameInput"
                            value="{draft>/lastName}"
                        />

                        <Label
                            text="Email"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="empEmailInput"
                            type="Email"
                            value="{draft>/email}"
                        />

                        <!-- DEPARTMENT -->

                        <Label
                            text="Department"
                            class="sapUiTinyMarginTop"
                        />

                        <Select
                            id="empDepartmentSelect"
                            width="100%"
                            selectedKey="{draft>/department}"
                            items="{adminOptions>/employeeDepartments}"
                        >
                            <core:Item
                                key="{adminOptions>}"
                                text="{adminOptions>}"
                            />
                        </Select>

                        <!-- ROLE -->

                        <Label
                            text="Role"
                            class="sapUiTinyMarginTop"
                        />

                        <Select
                            id="empRoleSelect"
                            width="100%"
                            selectedKey="{draft>/role}"
                            items="{adminOptions>/employeeRoles}"
                        >
                            <core:Item
                                key="{adminOptions>}"
                                text="{adminOptions>}"
                            />
                        </Select>

                        <!-- ACTIVE -->

                        <Label
                            text="Active"
                            class="sapUiTinyMarginTop"
                        />

                        <Switch
                            id="empActiveSwitch"
                            state="{draft>/active}"
                        />
                    </VBox>
                </content>

                <beginButton>
                    <Button
                        text="Save"
                        type="Emphasized"
                        press="onSaveEmployee"
                    />
                </beginButton>

                <endButton>
                    <Button
                        text="Cancel"
                        press="onCancelEmployee"
                    />
                </endButton>
            </Dialog>

            <!-- ========================================================= -->
            <!-- CUSTOMER DIALOG -->
            <!-- ========================================================= -->

            <Dialog
                id="customerDialog"
                title="New Customer"
                contentWidth="28rem"
            >
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label
                            text="Customer Number"
                            required="true"
                        />

                        <Input
                            id="custNumberInput"
                            value="{draft>/customerNumber}"
                        />

                        <Label
                            text="First Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="custFirstNameInput"
                            value="{draft>/firstName}"
                        />

                        <Label
                            text="Last Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="custLastNameInput"
                            value="{draft>/lastName}"
                        />

                        <Label
                            text="Email"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="custEmailInput"
                            type="Email"
                            value="{draft>/email}"
                        />

                        <Label
                            text="Phone"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="custPhoneInput"
                            value="{draft>/phone}"
                        />

                        <Label
                            text="Status"
                            class="sapUiTinyMarginTop"
                        />

                        <Select
                            id="custStatusSelect"
                            width="100%"
                            selectedKey="{draft>/status}"
                        >
                            <core:Item
                                key="Active"
                                text="Active"
                            />

                            <core:Item
                                key="Inactive"
                                text="Inactive"
                            />

                            <core:Item
                                key="Suspended"
                                text="Suspended"
                            />
                        </Select>
                    </VBox>
                </content>

                <beginButton>
                    <Button
                        text="Save"
                        type="Emphasized"
                        press="onSaveCustomer"
                    />
                </beginButton>

                <endButton>
                    <Button
                        text="Cancel"
                        press="onCancelCustomer"
                    />
                </endButton>
            </Dialog>

            <!-- ========================================================= -->
            <!-- CLAIM TYPE DIALOG -->
            <!-- ========================================================= -->

            <Dialog
                id="claimTypeDialog"
                title="New Claim Type"
                contentWidth="28rem"
            >
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label
                            text="Code"
                            required="true"
                        />

                        <Input
                            id="ctCodeInput"
                            value="{draft>/code}"
                        />

                        <Label
                            text="Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />

                        <Input
                            id="ctNameInput"
                            value="{draft>/name}"
                        />

                        <!-- CATEGORY -->

                        <Label
                            text="Category"
                            class="sapUiTinyMarginTop"
                        />

                        <Select
                            id="ctCategorySelect"
                            width="100%"
                            selectedKey="{draft>/category}"
                            items="{adminOptions>/claimTypeCategories}"
                        >
                            <core:Item
                                key="{adminOptions>}"
                                text="{adminOptions>}"
                            />
                        </Select>

                        <!-- ACTIVE -->

                        <Label
                            text="Active"
                            class="sapUiTinyMarginTop"
                        />

                        <Switch
                            id="ctActiveSwitch"
                            state="{draft>/active}"
                        />
                    </VBox>
                </content>

                <beginButton>
                    <Button
                        text="Save"
                        type="Emphasized"
                        press="onSaveClaimType"
                    />
                </beginButton>

                <endButton>
                    <Button
                        text="Cancel"
                        press="onCancelClaimType"
                    />
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>
