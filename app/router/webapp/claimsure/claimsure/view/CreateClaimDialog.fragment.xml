<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="createClaimDialog" title="New Claim" contentWidth="28rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Customer" labelFor="ccCustomer" required="true"/>
                <ComboBox id="ccCustomer" width="100%" class="sapUiTinyMarginBottom"
                    items="{admin>/Customers}">
                    <core:Item key="{admin>ID}" text="{admin>firstName} {admin>lastName} ({admin>customerNumber})"/>
                </ComboBox>

                <Label text="Policy" labelFor="ccPolicy" required="true"/>
                <ComboBox id="ccPolicy" width="100%" class="sapUiTinyMarginBottom"
                    items="{path: '/Policies', parameters: {$select: 'ID,policyNumber,status'}}">
                    <core:Item key="{ID}" text="{policyNumber} ({status})"/>
                </ComboBox>

                <Label text="Claim Type" labelFor="ccClaimType" required="true"/>
                <ComboBox id="ccClaimType" width="100%" class="sapUiTinyMarginBottom"
                    items="{admin>/ClaimTypes}">
                    <core:Item key="{admin>ID}" text="{admin>name}"/>
                </ComboBox>

                <Label text="Claimed Amount" labelFor="ccAmount" required="true"/>
                <Input id="ccAmount" type="Number" width="100%" class="sapUiTinyMarginBottom"/>

                <Label text="Incident Date" labelFor="ccDate" required="true"/>
                <DatePicker id="ccDate" width="100%" class="sapUiTinyMarginBottom" valueFormat="yyyy-MM-dd" displayFormat="medium"/>

                <Label text="Description" labelFor="ccDesc"/>
                <TextArea id="ccDesc" width="100%" rows="3"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>btnSave}" type="Emphasized" press=".onConfirmCreateClaim"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelCreateClaim"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>